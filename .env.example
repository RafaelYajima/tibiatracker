# ============================================================
# TibiaTracker — exemplo de ambiente (NUNCA coloque senha aqui)
# ============================================================
# Copie para .env.local:
#   cp .env.example .env.local
#
# Produção / Vercel / Supabase:
# Supabase > Connect > Transaction pooler (porta 6543).
# Copie a URI do painel; não tente inventar host ou usuário.
#
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_POOL_MAX=1
#
# Desenvolvimento com PostgreSQL local (template):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_POOL_MAX=5
